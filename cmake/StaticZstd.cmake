function(wasmedge_select_static_zstd_archive Output)
  set(Archive)
  set(FallbackArchive)
  if(TARGET zstd::libzstd_static)
    set(Archive zstd::libzstd_static)
  elseif(zstd_STATIC_LIBRARY AND EXISTS "${zstd_STATIC_LIBRARY}")
    set(Archive "${zstd_STATIC_LIBRARY}")
  endif()
  set(ZstdLibrary "${zstd_LIBRARY}")
  if(NOT ZstdLibrary AND TARGET zstd::libzstd_shared)
    get_target_property(ZstdConfigurations zstd::libzstd_shared
      IMPORTED_CONFIGURATIONS)
    set(ZstdProperties IMPORTED_IMPLIB IMPORTED_LOCATION)
    if(ZstdConfigurations)
      foreach(ZstdConfiguration IN LISTS ZstdConfigurations)
        string(TOUPPER "${ZstdConfiguration}" ZstdConfiguration)
        list(APPEND ZstdProperties
          IMPORTED_IMPLIB_${ZstdConfiguration}
          IMPORTED_LOCATION_${ZstdConfiguration})
      endforeach()
    endif()
    foreach(ZstdProperty IN LISTS ZstdProperties)
      get_target_property(ZstdLocation zstd::libzstd_shared ${ZstdProperty})
      if(ZstdLocation)
        set(ZstdLibrary "${ZstdLocation}")
        break()
      endif()
    endforeach()
  endif()
  if(NOT Archive AND ZstdLibrary)
    get_filename_component(ZstdPath "${ZstdLibrary}" DIRECTORY)
    if(MSVC OR "${CMAKE_CXX_SIMULATE_ID}" STREQUAL "MSVC")
      set(FallbackArchive
        "${ZstdPath}/zstd_static${CMAKE_STATIC_LIBRARY_SUFFIX}")
    else()
      set(FallbackArchive
        "${ZstdPath}/${CMAKE_STATIC_LIBRARY_PREFIX}zstd${CMAKE_STATIC_LIBRARY_SUFFIX}")
    endif()
    if(EXISTS "${FallbackArchive}")
      set(Archive "${FallbackArchive}")
    endif()
  endif()
  if(NOT Archive)
    message(FATAL_ERROR
      "LLVM requires a static zstd target or library, but none exists. Checked zstd::libzstd_static, zstd_STATIC_LIBRARY='${zstd_STATIC_LIBRARY}', and the archive beside '${ZstdLibrary}' ('${FallbackArchive}')")
  endif()
  set(${Output} "${Archive}" PARENT_SCOPE)
endfunction()
