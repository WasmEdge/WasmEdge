ARG BASE_IMAGE=wasmedge/wasmedge:latest@sha256:1f385c1a01accd2eb51ef9d531a37bb2d72451fe4fec42f036340c42cadb589d
ARG TOOLCHAIN=clang
FROM ${BASE_IMAGE} AS base

### env for clang
FROM base AS deps-clang

### env for gcc
FROM base AS deps-gcc

ENV CC=/usr/bin/gcc
ENV CXX=/usr/bin/g++

### final
FROM deps-${TOOLCHAIN} AS final
